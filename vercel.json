{
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/en/(.*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/es/(.*)",
      "destination": "/es/index.html"
    },
    {
      "source": "/bn/(.*)",
      "destination": "/bn/index.html"
    },
    {
      "source": "/ar/(.*)",
      "destination": "/ar/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
