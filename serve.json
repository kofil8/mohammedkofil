{
  "public": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/assets/*", "destination": "/assets/$1" },
    { "source": "/en/*", "destination": "/index.html" },
    { "source": "/es/*", "destination": "/index.html" },
    { "source": "/bn/*", "destination": "/index.html" },
    { "source": "/ar/*", "destination": "/index.html" },
    { "source": "/zh/*", "destination": "/index.html" },
    { "source": "*.js", "destination": "/$0" },
    { "source": "*.css", "destination": "/$0" },
    { "source": "*.png", "destination": "/$0" },
    { "source": "*.jpg", "destination": "/$0" },
    { "source": "*.svg", "destination": "/$0" },
    { "source": "*.gz", "destination": "/$0" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
