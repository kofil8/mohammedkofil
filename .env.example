# EmailJS Configuration
# Create a free account at https://www.emailjs.com/
# 1. Go to Dashboard > Services and create a service (e.g., Gmail)
# 2. Create an email template with placeholders: {{from_name}}, {{from_email}}, {{message}}, {{to_email}}
# 3. Go to Accounts > API Keys to get your Public Key
# 4. Fill in the values below

VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Contact Email (where messages will be sent)
VITE_CONTACT_EMAIL=your-email@gmail.com
